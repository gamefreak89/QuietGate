<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <!-- Also declare the shared foreground type here for lint's overlay-manifest analysis. -->
        <service android:name="org.open.quietgate.GuardNotificationService"
            android:foregroundServiceType="specialUse" />
        <activity android:name="org.open.quietgate.GoogleContactsActivity" android:exported="false" />
        <service android:name="org.open.quietgate.GoogleContactsRefreshService"
            android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    </application>
</manifest>
